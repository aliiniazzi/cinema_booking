{
  "info": {
    "name": "Cinema Booking API",
    "description": "ابتدا Get CSRF token، سپس Login و دوباره Get CSRF token را اجرا کنید. کوکی‌های Postman باید فعال باشند. برای ورود با نقش دیگر ابتدا Logout و سپس دریافت CSRF و ورود و دریافت CSRF را تکرار کنید. ابتدا Create movie را اجرا کنید تا شناسه برای ویرایش و حذف ذخیره شود. پس از خرید، شناسه بلیط ذخیره می‌شود.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8082"
    },
    {
      "key": "csrfToken",
      "value": ""
    },
    {
      "key": "movieId",
      "value": "1"
    },
    {
      "key": "ticketId",
      "value": ""
    },
    {
      "key": "adminMovieId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Get CSRF token",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/csrf",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "csrf"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) { pm.collectionVariables.set('csrfToken', pm.response.json().data.token); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Register user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-XSRF-TOKEN",
                "value": "{{csrfToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"new{{$timestamp}}\",\n  \"email\": \"new{{$timestamp}}@example.com\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Login USER",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-XSRF-TOKEN",
                "value": "{{csrfToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"user1\",\n  \"password\": \"user123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Login ADMIN",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-XSRF-TOKEN",
                "value": "{{csrfToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Current user",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "me"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-XSRF-TOKEN",
                "value": "{{csrfToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "logout"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Movies - public",
      "item": [
        {
          "name": "List movies",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/movies",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "movies"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Search movies",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/movies/search?title=Interstellar",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "movies",
                "search"
              ],
              "query": [
                {
                  "key": "title",
                  "value": "Interstellar"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Movie details",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/movies/{{movieId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "movies",
                "{{movieId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Available seats",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/movies/{{movieId}}/available-seats",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "movies",
                "{{movieId}}",
                "available-seats"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Tickets - USER",
      "item": [
        {
          "name": "Book ticket",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-XSRF-TOKEN",
                "value": "{{csrfToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/tickets/book",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tickets",
                "book"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"movieId\": 1,\n  \"seatNumber\": 12\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) { pm.collectionVariables.set('ticketId', pm.response.json().data.id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "My tickets",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tickets/my-tickets",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tickets",
                "my-tickets"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Cancel ticket",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "X-XSRF-TOKEN",
                "value": "{{csrfToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/tickets/{{ticketId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tickets",
                "{{ticketId}}"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Create movie",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-XSRF-TOKEN",
                "value": "{{csrfToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/movies",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "movies"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Postman Film {{$timestamp}}\",\n  \"genre\": \"Drama\",\n  \"durationMinutes\": 120,\n  \"releaseDate\": \"2026-01-01\",\n  \"description\": \"A sample film\",\n  \"price\": 120000,\n  \"cinemaHallId\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) { pm.collectionVariables.set('adminMovieId', pm.response.json().data.id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Update movie",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "X-XSRF-TOKEN",
                "value": "{{csrfToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/movies/{{adminMovieId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "movies",
                "{{adminMovieId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Postman Film Updated {{$timestamp}}\",\n  \"genre\": \"Drama\",\n  \"durationMinutes\": 120,\n  \"releaseDate\": \"2026-01-01\",\n  \"description\": \"A sample film\",\n  \"price\": 120000,\n  \"cinemaHallId\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Delete movie",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "X-XSRF-TOKEN",
                "value": "{{csrfToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/movies/{{adminMovieId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "movies",
                "{{adminMovieId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Sales statistics",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/admin/tickets/stats",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "tickets",
                "stats"
              ]
            }
          },
          "response": []
        }
      ]
    }
  ]
}
